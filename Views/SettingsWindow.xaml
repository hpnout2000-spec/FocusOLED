<Window x:Class="FocusGlow.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusGlow — Настройки"
        Height="540" Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- Windows 11 Dark Theme Colors -->
        <SolidColorBrush x:Key="BgBrush" Color="#18181A" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#222226" />
        <SolidColorBrush x:Key="BorderBrush" Color="#303036" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9A9AA6" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#4285F4" />
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="#9B72CB" />

        <!-- Linear gradient for accent highlights -->
        <LinearGradientBrush x:Key="GeminiGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4285F4" Offset="0.0" />
            <GradientStop Color="#9B72CB" Offset="0.4" />
            <GradientStop Color="#D96570" Offset="0.8" />
            <GradientStop Color="#F4AF5F" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Modern button style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A30" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#383842" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#35353E" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#50505E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25252A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button (Gradient) -->
        <Style x:Key="PrimaryGradientButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GeminiGradient}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Effect="{x:Null}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Titlebar window control buttons -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8A8A96" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#303038" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25252C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button specifically -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Main Window Border with Win11 Rounded Corners -->
    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" /> <!-- Title Bar -->
                <RowDefinition Height="*" />  <!-- Content -->
                <RowDefinition Height="Auto" /> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Custom Drag Title Bar -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseDown"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0">
                <Grid Margin="14,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Holographic glowing icon -->
                        <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource GeminiGradient}" Margin="0,0,10,0">
                            <Ellipse Width="8" Height="8" Fill="#18181A" />
                        </Border>
                        <TextBlock Text="FocusGlow"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Windows 11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="8,2,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Content="—" Click="MinimizeButton_Click" ToolTip="Свернуть в трей" />
                        <Button Style="{StaticResource CloseButtonStyle}" Content="✕" Click="CloseButton_Click" ToolTip="Скрыть в трей" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,14,16,10">
                <StackPanel>
                    <!-- Card 1: Global Hotkey Assignment -->
                    <Border Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Горячая клавиша активации"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="14" />
                            <TextBlock Text="Нажмите комбинацию клавиш или боковую кнопку мыши (XButton1/2)"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Margin="0,3,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Current Hotkey Badge / Button -->
                                <Border Grid.Column="0"
                                        x:Name="HotkeyBadgeBorder"
                                        Background="#18181C"
                                        BorderBrush="{StaticResource AccentBlueBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,0,8,0">
                                    <TextBlock x:Name="HotkeyDisplayText"
                                               Text="Alt + F"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               HorizontalAlignment="Center" />
                                </Border>

                                <!-- Record Button -->
                                <Button Grid.Column="1"
                                        x:Name="RecordHotkeyButton"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Content="Записать"
                                        Click="RecordHotkeyButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Corner Radius (Windows 11) -->
                    <Border Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Скругление углов окна"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13" />
                                <TextBlock x:Name="CornerRadiusValueText"
                                           Text="8 px"
                                           Foreground="{StaticResource AccentBlueBrush}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Text="Стандарт Windows 11 — 8 px. Для развернутых окон всегда 0 px."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,10" />

                            <Slider x:Name="CornerRadiusSlider"
                                    Minimum="0" Maximum="24" Value="8"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="CornerRadiusSlider_ValueChanged" />
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Dimming Speed & Physics -->
                    <Border Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Множитель скорости анимации"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13" />
                                <TextBlock x:Name="DimSpeedValueText"
                                           Text="1.0x"
                                           Foreground="{StaticResource AccentPurpleBrush}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Text="Быстрое затемнение до 50% (~450 мс) и глубокое до 100% (~1.5 с)."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,10" />

                            <Slider x:Name="DimSpeedSlider"
                                    Minimum="0.5" Maximum="2.0" Value="1.0"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    ValueChanged="DimSpeedSlider_ValueChanged" />
                        </StackPanel>
                    </Border>

                    <!-- Test Focus Mode Button -->
                    <Button Style="{StaticResource PrimaryGradientButtonStyle}"
                            Content="✨ Проверить режим фокуса прямо сейчас"
                            Click="TestFocusButton_Click"
                            Margin="0,4,0,4" />

                    <TextBlock Text="💡 Наведите курсор на любое окно перед нажатием или используйте горячую клавишу. Для выхода нажмите Escape."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="8,8,8,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- Footer: Status & Tray notice -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,10"
                    Background="#161618">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#34C759" Margin="0,0,8,0" />
                        <TextBlock Text="Приложение активно в трее"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" />
                    </StackPanel>

                    <Button Style="{StaticResource ModernButtonStyle}"
                            Content="В трей"
                            Padding="12,4"
                            FontSize="11"
                            HorizontalAlignment="Right"
                            Click="HideToTrayButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
