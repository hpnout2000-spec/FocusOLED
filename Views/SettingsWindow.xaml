<Window x:Class="FocusGlow.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusGlow"
        Width="360" Height="248"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#161617"
        Foreground="#F5F5F7"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      CornerRadius="10"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Минималистичная кнопка-пилюля для бинда -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#242426" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="BorderBrush" Value="#343438" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinWidth" Value="108" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E2E32" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#48484E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E1E20" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Тонкий слайдер в стиле macOS -->
        <Style x:Key="MinimalSliderStyle" TargetType="Slider">
            <Setter Property="Width" Value="110" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" Background="Transparent">
                            <Border Height="3" CornerRadius="1.5" Background="#2C2C30" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" CornerRadius="1.5" Background="#D1D1D6" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="12" Height="12" Fill="#F5F5F7" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseIconStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#6E6E73" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#262629" />
                                <Setter Property="Foreground" Value="#F5F5F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22,12,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <TextBlock Text="FocusGlow"
                       FontSize="13.5"
                       FontWeight="SemiBold"
                       Foreground="#F5F5F7"
                       VerticalAlignment="Center" />
            <Button Style="{StaticResource CloseIconStyle}"
                    Content="✕"
                    HorizontalAlignment="Right"
                    Click="CloseButton_Click"
                    ToolTip="Hide to tray" />
        </Grid>

        <!-- Clean settings without card clutter -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,4">
            <!-- Activation Key -->
            <Grid Margin="0,0,0,16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Activation Key" FontSize="13" Foreground="#F5F5F7" />
                    <TextBlock Text="Keyboard shortcut or mouse side button" FontSize="11" Foreground="#6E6E73" Margin="0,2,0,0" />
                </StackPanel>

                <Button x:Name="HotkeyPillButton"
                        Style="{StaticResource PillButtonStyle}"
                        Content="Alt + F"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="RecordHotkeyButton_Click" />
            </Grid>

            <!-- Corner Radius -->
            <Grid Margin="0,0,0,14">
                <TextBlock Text="Corner Radius" FontSize="13" Foreground="#F5F5F7" VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="CornerRadiusValueText"
                               Text="8 px"
                               FontSize="12"
                               Foreground="#8E8E93"
                               Width="36"
                               TextAlignment="Right"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                    <Slider x:Name="CornerRadiusSlider"
                            Style="{StaticResource MinimalSliderStyle}"
                            Minimum="0" Maximum="20" Value="8"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="CornerRadiusSlider_ValueChanged" />
                </StackPanel>
            </Grid>

            <!-- Dimming Speed -->
            <Grid>
                <TextBlock Text="Dimming Speed" FontSize="13" Foreground="#F5F5F7" VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="DimSpeedValueText"
                               Text="1.0×"
                               FontSize="12"
                               Foreground="#8E8E93"
                               Width="36"
                               TextAlignment="Right"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                    <Slider x:Name="DimSpeedSlider"
                            Style="{StaticResource MinimalSliderStyle}"
                            Minimum="0.5" Maximum="2.0" Value="1.0"
                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                            ValueChanged="DimSpeedSlider_ValueChanged" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Hint -->
        <TextBlock Grid.Row="2"
                   Text="Hover over any window and press key · Esc to exit"
                   FontSize="11"
                   Foreground="#6E6E73"
                   HorizontalAlignment="Center" />
    </Grid>
</Window>
